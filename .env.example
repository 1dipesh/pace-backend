APP_NAME=Pace API
APP_ENV=local
APP_VERSION=0.10.0
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://pace:pace@localhost:5432/pace

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_JWT_ALGORITHMS=["ES256","RS256"]
AUTH_CLOCK_SKEW_SECONDS=30

# Pace AI — server only. Never expose this key in Vite or browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_BETA_UNLIMITED=true
AI_REQUESTS_PER_MINUTE=10
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=700
AI_HISTORY_MESSAGES=20
