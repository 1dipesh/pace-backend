APP_NAME=Pace API
APP_ENV=local
APP_VERSION=0.8.2
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://pace:pace@localhost:5432/pace

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

