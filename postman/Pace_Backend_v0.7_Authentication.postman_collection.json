{
  "info": {
    "name": "Pace Backend v0.7 - Authentication",
    "description": "Validate Supabase access tokens and verify authenticated Pace user ownership. Set access_token in the Pace Local environment from the frontend Supabase session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Public health check",
      "request": {
        "auth": {"type": "noauth"},
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Get or provision current Pace user",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/auth/me"
      }
    },
    {
      "name": "Confirm protected profile access",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/profile"
      }
    },
    {
      "name": "Confirm missing token is rejected",
      "request": {
        "auth": {"type": "noauth"},
        "method": "GET",
        "url": "{{base_url}}/api/v1/auth/me"
      }
    }
  ]
}
